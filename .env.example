# Shopping-Warehouse Database (Supabase project wldjpcuaqxzmmiosivzi)
# Option A — full URL from Project Settings → Database:
DATABASE_URL=postgresql://postgres.wldjpcuaqxzmmiosivzi:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Option B — password only (URL is built automatically):
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=wldjpcuaqxzmmiosivzi
# SUPABASE_REGION=eu-central-1

# Optional API key for HTTP MCP / REST clients. Leave empty to disable auth.
MCP_API_KEY=

CASE_DESK_MCP_PORT=4102
MCP_HOST=127.0.0.1

# Host headers accepted when MCP_HOST is not loopback (comma-separated). Empty = no check
# (ECS: Service Connect name / ALB DNS name / task IP; MCP_API_KEY guards access).
MCP_ALLOWED_HOSTS=

# Schema of the Case Desk tables. Test copy: own schema in the same database as case-desk-agent.
DB_SCHEMA=dispute_case_desk_test

DEMO_SEED=dispute_v1
